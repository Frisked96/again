{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BuildingPrefabCatalog",
  "type": "object",
  "required": ["templates"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "templates": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/BuildingTemplate"
      }
    }
  },
  "definitions": {
    "BuildingTemplate": {
      "type": "object",
      "required": ["id", "name", "category", "width", "height", "layout"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this building template"
        },
        "name": {
          "type": "string",
          "description": "Display name of the building"
        },
        "category": {
          "type": "string",
          "enum": ["residential", "commercial", "civic", "religious", "military", "industrial"],
          "description": "Functional category of the building"
        },
        "settlement_tiers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["hamlet", "village", "town", "city"]
          },
          "description": "Settlement sizes where this building can spawn"
        },
        "biomes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Biomes where this building is culturally/environmentally appropriate"
        },
        "width": {
          "type": "integer",
          "minimum": 3,
          "description": "Width in tiles"
        },
        "height": {
          "type": "integer",
          "minimum": 3,
          "description": "Height in tiles"
        },
        "wall_type": {
          "type": "string",
          "description": "Default wall tile type (e.g. WoodWall, StoneWall)"
        },
        "floor_type": {
          "type": "string",
          "description": "Default floor tile type (e.g. WoodFloor, StoneFloor)"
        },
        "layout": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "ASCII grid rows defining walls (#), floors (.), doors (+), stairs (>), etc."
        },
        "rooms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "x1", "y1", "x2", "y2"],
            "properties": {
              "name": {
                "type": "string"
              },
              "x1": {
                "type": "integer"
              },
              "y1": {
                "type": "integer"
              },
              "x2": {
                "type": "integer"
              },
              "y2": {
                "type": "integer"
              }
            }
          },
          "description": "Named room bounding boxes inside the building"
        },
        "floors": {
          "type": "array",
          "description": "Multi-level vertical floor configurations (-1 = cellar, 0 = ground, 1 = upper)",
          "items": {
            "type": "object",
            "required": ["level", "layout"],
            "properties": {
              "level": {
                "type": "integer",
                "description": "Vertical Z elevation of this floor"
              },
              "name": {
                "type": "string",
                "description": "Display name of this specific floor"
              },
              "wall_type": {
                "type": "string"
              },
              "floor_type": {
                "type": "string"
              },
              "layout": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rooms": {
                "$ref": "#/definitions/BuildingTemplate/properties/rooms"
              }
            }
          }
        }
      }
    }
  }
}
